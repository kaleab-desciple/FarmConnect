{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://your-domain.com/schemas/product.schema.json",
  "title": "Product",
  "description": "Product offered by a farmer for sale through the platform",
  "type": "object",
  "required": [
    "id",
    "farmer_id",
    "name",
    "category",
    "unit",
    "base_price",
    "quantity_available",
    "is_active",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique product identifier"
    },
    "farmer_id": {
      "type": "string",
      "description": "Owner farmer ID"
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "category": {
      "$ref": "enums.schema.json#/definitions/Category"
    },
    "unit": {
      "$ref": "enums.schema.json#/definitions/Unit"
    },
    "base_price": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Farmer-set price per unit (before delivery & platform margin)"
    },
    "currency": {
      "type": "string",
      "default": "USD",
      "description": "Currency code (ISO 4217)"
    },
    "quantity_available": {
      "type": "number",
      "minimum": 0
    },
    "quality_grade": {
      "$ref": "enums.schema.json#/definitions/QualityGrade"
    },
    "harvest_date": {
      "type": "string",
      "format": "date"
    },
    "expiry_date": {
      "type": "string",
      "format": "date"
    },
    "location": {
      "type": "object",
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      },
      "description": "Farm location for geo-clustering & logistics"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      },
      "maxItems": 10
    },
    "is_active": {
      "type": "boolean",
      "description": "Whether the product is currently sellable"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "description": "Future-proof extension field (certifications, tags, etc.)"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "total_quantity": {
      "type": ["number", "null"],
      "minimum": 0,
      "description": "Total quantity"
    },
    "reserved_quantity": {
      "type": ["number", "null"],
      "minimum": 0,
      "description": "Reserved quantity"
    },
    "sold_quantity": {
      "type": ["number", "null"],
      "minimum": 0,
      "description": "Sold quantity"
    },
    "spoiled_quantity": {
      "type": ["number", "null"],
      "minimum": 0,
      "description": "Spoiled quantity"
    },
    "harvest_id": {
      "type": ["string", "null"],
      "description": "Harvest ID"
    },
    "crop_cycle_id": {
      "type": ["string", "null"],
      "description": "Crop cycle ID"
    },
    "version": {
      "type": ["integer", "null"],
      "description": "Version for optimistic locking"
    },
    "deleted_at": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "Soft delete timestamp"
    }
  },
  "additionalProperties": false
}
