
{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Earning",
    "type": "object",
    "properties": {
      "farmer_id": {
        "type": "string",
        "format": "uuid"
      },
      "total_earnings": {
        "type": "number"
      },
      "period": {
        "type": "string",
        "enum": [
          "daily",
          "weekly",
          "monthly",
          "yearly"
        ]
      }
    },
    "required": [
      "farmer_id",
      "total_earnings",
      "period"
    ]
  }
