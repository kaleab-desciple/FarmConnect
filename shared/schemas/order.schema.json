{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://your-domain.com/schemas/order.schema.json",
  "title": "Order",
  "type": "object",
  "required": [
    "id",
    "farmer_id",
    "merchant_id",
    "product_id",
    "quantity",
    "unit_price",
    "total_price",
    "status",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "farmer_id": {
      "type": "string"
    },
    "merchant_id": {
      "type": "string"
    },
    "product_id": {
      "type": "string"
    },
    "quantity": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "unit_price": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "delivery_cost": {
      "type": "number",
      "minimum": 0
    },
    "platform_fee": {
      "type": "number",
      "minimum": 0
    },
    "total_price": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Final price paid by merchant (includes all costs)"
    },
    "status": {
      "$ref": "enums.schema.json#/definitions/OrderStatus"
    },
    "escrow_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}