{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://your-domain.com/schemas/loan.schema.json",
  "title": "Loan",
  "type": "object",
  "required": [
    "id",
    "farmer_id",
    "principal",
    "state",
    "interest_rate",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "farmer_id": {
      "type": "string"
    },
    "principal": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "interest_rate": {
      "type": "number",
      "minimum": 0
    },
    "state": {
      "$ref": "enums.schema.json#/definitions/LoanState"
    },
    "auto_approved": {
      "type": "boolean",
      "default": false
    },
    "repayment_schedule": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "due_date",
          "amount"
        ],
        "properties": {
          "due_date": {
            "type": "string",
            "format": "date"
          },
          "amount": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "closed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}