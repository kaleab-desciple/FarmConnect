{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.org/schemas/user.schema.json",
  "title": "User",
  "type": "object",
  "required": [
    "id",
    "role",
    "name",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "keycloak_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "role": {
      "$ref": "enums.schema.json#/definitions/UserRole"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "email": {
      "type": [
        "string",
        "null"
      ],
      "format": "email"
    },
    "phone": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}